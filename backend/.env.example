# ─── Server ────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ─────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sefm

# ─── Redis (cache + OTP storage) ───────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Authentication ────────────────────────
JWT_SECRET=replace-with-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=24h

# ─── Email (SMTP) ──────────────────────────────
# For development: use Gmail App Password (https://myaccount.google.com/apppasswords)
# For production: use Brevo or SendGrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="SEFM Security <noreply@syrotech.com>"

# ─── MinIO (S3-compatible file storage) ────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sefm-files

# ─── Logging ───────────────────────────────────
LOG_LEVEL=info